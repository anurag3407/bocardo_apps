{
  "name": "bocardo-api",
  "version": "0.1.0",
  "private": true,
  "description": "Bocardo backend — NestJS (Fastify) modular monolith",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "openapi": "nest build && OPENAPI_ONLY=1 node dist/main.js",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "kysely-codegen --dialect postgres --out-file src/infra/database/db.generated.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@upstash/qstash": "^2.12.1",
    "@upstash/redis": "^1.39.0",
    "fastify": "^5.11.3",
    "firebase-admin": "^14.5.0",
    "jose": "^6.2.13",
    "kysely": "^0.29.7",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.1",
    "razorpay": "^2.9.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "jest": "^29.7.0",
    "kysely-codegen": "^0.20.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
