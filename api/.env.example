# ── Runtime ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of this API (QStash calls back here for delayed jobs)
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
# 32+ random chars; derives delivery OTPs
APP_SECRET=dev-only-insecure-app-secret

# ── Supabase (local defaults from `supabase start`) ──────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 projects only. Leave empty to verify with the project's JWKS (asymmetric keys).
SUPABASE_JWT_SECRET=

# ── Upstash Redis (empty = in-memory store, dev only) ────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Upstash QStash (empty = in-process timers, dev only) ─
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── Firebase Cloud Messaging (empty = log pushes only) ───
# Path to service-account JSON, or the JSON itself base64-encoded
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ── Maps ─────────────────────────────────────────────────
GEO_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=

# ── Payments (empty = mock provider, dev only) ───────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
