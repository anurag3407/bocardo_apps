# Bocardo API (use your LAN IP on a physical device, e.g. http://192.168.1.10:4000)
EXPO_PUBLIC_API_URL=http://localhost:4000
# Supabase project (auth + realtime only)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Mapbox public token (pk.…)
EXPO_PUBLIC_MAPBOX_TOKEN=
# Firebase config files (git-ignored); defaults to ./firebase/*
GOOGLE_SERVICES_JSON=./firebase/google-services.json
GOOGLE_SERVICE_INFO_PLIST=./firebase/GoogleService-Info.plist
# Firebase App Check debug token for dev builds (register it in the Firebase console)
EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=
